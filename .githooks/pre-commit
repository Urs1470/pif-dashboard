#!/bin/sh
# Auto-regenerare memorie proiect (docs/memory/CODE_MAP.md + API_MAP.md + DB_MAP.md)
# Activare (o singura data per clona): git config core.hooksPath .githooks
# Ruleaza doar daca commit-ul atinge cod relevant; nu blocheaza commit-ul la eroare.
#
# Pana pe 2026-10-03 hook-ul avea aici si o poarta pentru `static/dist/`: refuza un commit care
# schimba build-ul SPA-ului fara sa urce `VERSION` din `static/service-worker.js`. Interfata
# veche a fost retrasa, `static/dist/` nu mai exista, iar service worker-ul nu mai are versiune
# (se retrage singur), deci poarta a plecat. Cum se aduce inapoi:
# docs/decizii/2026-10-03-retragerea-interfetei-vechi.md.

STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)

echo "$STAGED" | grep -qE '^(app\.py|database\.py|utils\.py|csrf\.py|labels\.py|blueprints/.*\.py|static/service-worker\.js)$' || exit 0

# Interpretorul se ALEGE PROBAND, nu dupa nume. Pe Windows `python3` exista in PATH
# ca alias catre Microsoft Store (`WindowsApps/python3`): `command -v` il gaseste,
# deci vechea verificare il alegea, iar el tipareste "Python was not found" si iese
# cu 49. Rezultatul: pe PC-ul de acasa regenerarea hartilor n-a rulat NICIODATA —
# doar tiparea un avertisment care trecea in derulare. Exact clasa de esec pe care
# hartile trebuiau s-o previna: o absenta tacuta.
PY=
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c 'import sys' >/dev/null 2>&1; then
        PY=$cand
        break
    fi
done
if [ -z "$PY" ]; then
    echo "[pre-commit] python negasit - sar regenerarea memoriei (ruleaza manual: python scripts/gen_memory.py)" >&2
    exit 0
fi

if $PY scripts/gen_memory.py >/dev/null 2>&1; then
    git add docs/memory/CODE_MAP.md docs/memory/API_MAP.md docs/memory/DB_MAP.md
    echo "[pre-commit] memorie regenerata (CODE_MAP + API_MAP + DB_MAP)"
else
    echo "[pre-commit] AVERTISMENT: scripts/gen_memory.py a esuat - commit continua, regenereaza manual" >&2
fi

exit 0
