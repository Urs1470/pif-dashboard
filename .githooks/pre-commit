#!/bin/sh
# Auto-regenerare memorie proiect (docs/memory/CODE_MAP.md + API_MAP.md)
# Activare (o singura data per clona): git config core.hooksPath .githooks
# Ruleaza doar daca commit-ul atinge cod relevant; nu blocheaza commit-ul la eroare.

STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)

# ---- Poarta service worker-ului -------------------------------------------
# Un build nou nu ajunge pe telefon daca `static/service-worker.js` ramane
# identic pe octeti: browserul compara FISIERUL, nu continutul cache-ului, deci
# `updatefound` nu se declanseaza si toastul de actualizare nu apare niciodata.
# Pe telefon, unde aplicatia nu se inchide complet, ramai pe versiunea veche la
# nesfarsit — s-a intamplat cu tot redesignul din 8 august (8 commituri).
# De aceea porti `static/dist/` si `VERSION` impreuna. Blocheaza commit-ul:
# regula asta nu are cum sa fie reparata mai tarziu, se vede abia pe telefon.
if echo "$STAGED" | grep -qE '^static/dist/'; then
    if ! echo "$STAGED" | grep -qx 'static/service-worker.js' \
       || ! git diff --cached -U0 -- static/service-worker.js | grep -qE '^\+const VERSION'; then
        echo "[pre-commit] OPRIT: ai schimbat static/dist/ fara sa urci VERSION din static/service-worker.js." >&2
        echo "             Fara asta, build-ul nou NU ajunge pe telefon (vezi comentariul din fisier)." >&2
        echo "             Urca VERSION (v100 -> v101), 'git add static/service-worker.js', apoi comite din nou." >&2
        exit 1
    fi
fi
# ---------------------------------------------------------------------------

echo "$STAGED" | grep -qE '^(app\.py|database\.py|utils\.py|csrf\.py|labels\.py|blueprints/.*\.py|static/(app|mobile|core)\.js)$' || exit 0

if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "[pre-commit] python negasit - sar regenerarea memoriei (ruleaza manual: python scripts/gen_memory.py)" >&2
    exit 0
fi

if $PY scripts/gen_memory.py >/dev/null 2>&1; then
    git add docs/memory/CODE_MAP.md docs/memory/API_MAP.md
    echo "[pre-commit] memorie regenerata (docs/memory/CODE_MAP.md + API_MAP.md)"
else
    echo "[pre-commit] AVERTISMENT: scripts/gen_memory.py a esuat - commit continua, regenereaza manual" >&2
fi

exit 0
