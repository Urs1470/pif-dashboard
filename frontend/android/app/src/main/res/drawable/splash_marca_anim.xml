<?xml version="1.0" encoding="utf-8"?>
<!--
  UNDA SE SCRIE, NATIV. Singura miscare a deschiderii.

  Era in pagina (`spUnda`, cu `stroke-dashoffset`), dar acolo venea DUPA splashul
  de sistem — deci dupa ce marca fusese deja aratata o data. Aici e prima si
  singura oara cand marca apare, deci scrierea e a ei.

  `trimPathEnd` e echivalentul lui `stroke-dashoffset` din SVG: traseul se
  deseneaza de la inceput catre capat. Durata 600ms o vede si sistemul, prin
  `windowSplashScreenAnimationDuration` din tema — altfel ar putea scoate
  splashul la jumatatea desenului.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_marca">
    <target android:name="unda">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="600"
                android:startOffset="120"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
