<!-- Iconita din BARA DE STARE. Android o deseneaza ca siluetă: tot ce nu e
     transparent devine alb (sau gri, dupa tema), deci culorile n-au ce cauta
     aici — de-aia nu e marca intreaga, ci doar unda, fara tile si fara text.
     O marca cu doua tonuri sau cu litere ar aparea ca un patrat alb.
     Aceleasi coordonate ca `frontend/public/favicon.svg`, ca sa fie aceeasi
     forma pe care o vezi pe ecranul principal. Grosimea e 7 (ca la favicon):
     la 24dp un traseu de 5.6/64 s-ar stinge.
     Ramane VECTOR, nu PNG-uri per densitate: aceeasi forma la orice ecran,
     dintr-un singur fisier care nu se poate desincroniza cu el insusi. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="64"
    android:viewportHeight="64"
    android:tint="#FFFFFFFF">
    <path
        android:pathData="M10,42 H21.5 V22 H32 V42 H42.5 V22 H54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
