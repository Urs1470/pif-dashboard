<?xml version="1.0" encoding="utf-8"?>
<!--
  Culorile splashului NATIV. Trebuie sa fie aceleasi cu `bg`, `accent` si
  `accent-text` din `frontend/src/styles/tokens.css` — daca difera fie si cu o
  nuanta, se vede exact in clipa in care sistemul preda pagina.

  Astea sunt valorile pentru tema DESCHISA (`values/` e implicitul); cele inchise
  stau in `values-night/`. Aparatul alege dupa modul lui de noapte.

  LIMITA, scrisa ca sa nu para defect: aplicatia web isi poate FIXA tema din
  setari (`theme-mod` in localStorage), independent de sistem. Splashul nativ nu
  are de unde sti asta — el ruleaza inainte sa existe o pagina. Deci daca tii
  aplicatia pe „light" cu telefonul pe intuneric, prima clipa vine pe fondul
  sistemului. Cu tema pe „auto" (implicit) se potrivesc mereu.
-->
<resources>
    <color name="splash_bg">#f5f5f9</color>
    <color name="splash_placa">#63638f</color>
    <color name="splash_unda">#ffffff</color>
</resources>
