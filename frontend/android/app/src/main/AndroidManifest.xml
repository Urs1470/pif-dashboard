<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ALARMA EXACTA. Fara ea, Android 12+ programeaza notificarile „inexact":
         sistemul le poate aduna si le poate amana cu zeci de minute, ca sa
         trezeasca telefonul o singura data. O notificare de dimineata care vine
         la 8:40 nu mai e o notificare de dimineata.

         Permisiunea NU e acordata automat — utilizatorul o da din Setari
         (Alarme si mementouri), si o poate retrage oricand. Cand o retrage,
         sistemul reporneste aplicatia SI STERGE alarmele exacte deja puse, de
         aceea `notificari.js` verifica `checkExactNotificationSetting()` la
         fiecare pornire si cade pe alarma inexacta in loc sa taca.

         Nu folosim USE_EXACT_ALARM (care s-ar acorda singura): e rezervata
         aplicatiilor de tip ceas desteptator si ar fi respinsa in Play. Aici
         instalarea e directa, dar regula ramane cea corecta. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Plugin-ul de notificari o declara oricum prin fuziunea de manifeste;
         scrisa si aici ca sa fie vizibila cand cauti ce cere aplicatia. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ACTUALIZAREA DIN APLICATIE. Aplicatia nu vine dintr-un magazin, deci
         nimeni nu o actualizeaza in locul ei: isi ia singura APK-ul de pe
         serverul propriu si il preda instalatorului de sistem.
         Din Android 8 permisiunea asta e SI un comutator per aplicatie, pe care
         il dai separat din Setari; `InstalarePlugin.poateInstala()` il verifica
         inainte, ca sa nu deschidem un instalator care refuza fara sa spuna
         de ce. Instalarea propriu-zisa o confirmi tot tu — nimic nu se
         instaleaza in tacere, si asta e o granita, nu o lipsa. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
